{
  "config": {
    "step": {
      "user": {
        "title": "Connect a Daikin air conditioner",
        "description": "Local control talks to the Wi-Fi adapter on your network and needs no account. Cloud control uses your Daikin AC (India) app account.",
        "menu_options": {
          "discover": "Find adapters on my network",
          "local": "Enter adapter IP address",
          "cloud": "GO DAIKIN app account (cloud)"
        }
      },
      "local": {
        "title": "Local adapter",
        "data": {
          "host": "Host",
          "pin": "Lock PIN"
        },
        "data_description": {
          "host": "IP address or hostname of the air conditioner's Wi-Fi adapter.",
          "pin": "Only needed if a lock password is set on the unit in the GO DAIKIN app."
        }
      },
      "discover": {
        "title": "Adapters found",
        "data": {
          "adapter": "Adapter"
        }
      },
      "pin": {
        "title": "Lock PIN required",
        "description": "The adapter at {host} is locked. Enter the 4-digit lock PIN set in the GO DAIKIN app.",
        "data": {
          "pin": "Lock PIN"
        }
      },
      "reconfigure": {
        "title": "Reconfigure adapter",
        "data": {
          "host": "Host",
          "pin": "Lock PIN"
        },
        "data_description": {
          "host": "IP address or hostname of the air conditioner's Wi-Fi adapter.",
          "pin": "Only needed if a lock password is set on the unit."
        }
      },
      "reauth_confirm": {
        "title": "Lock PIN rejected",
        "description": "The adapter at {host} rejected the lock PIN. Enter the current PIN, or leave it empty if the lock was removed.",
        "data": {
          "pin": "Lock PIN"
        }
      },
      "cloud": {
        "title": "Daikin account login",
        "menu_options": {
          "cloud_password": "Phone number and password",
          "cloud_otp": "Phone number and SMS code"
        }
      },
      "reauth_cloud": {
        "title": "Daikin account session expired",
        "description": "Daikin rejected the saved session. The session may have expired or been signed out elsewhere. Log in again to keep controlling your units through the cloud; choose \"Stay signed in\" to have this handled automatically next time.",
        "menu_options": {
          "cloud_password": "Phone number and password",
          "cloud_otp": "Phone number and SMS code"
        }
      },
      "cloud_password": {
        "title": "Daikin account",
        "data": {
          "phone": "Phone number",
          "password": "Password",
          "store_password": "Stay signed in"
        },
        "data_description": {
          "phone": "The mobile number registered in the GO DAIKIN app, with country code (for example +919876543210).",
          "store_password": "Store the password so the integration can log in again by itself if Daikin ends the session. Without it, you will be asked to log in again."
        }
      },
      "cloud_otp": {
        "title": "Daikin account",
        "description": "An SMS code will be sent to this number.",
        "data": {
          "phone": "Phone number"
        },
        "data_description": {
          "phone": "The mobile number registered in the GO DAIKIN app, with country code (for example +919876543210)."
        }
      },
      "cloud_otp_verify": {
        "title": "Enter SMS code",
        "description": "Enter the code sent to {phone}.",
        "data": {
          "otp": "SMS code"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_host": "Enter an IP address or hostname, optionally with a port (for example 192.168.1.50)",
